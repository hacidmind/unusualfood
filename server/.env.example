# Backend environment variables

# Server port
PORT=5000

# JWT secret key (change this in production to a long, random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-12345

# MongoDB connection string (get this from MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://unusual_food_user:YOUR_PASSWORD@YOUR_CLUSTER_NAME.mongodb.net/unusual_food?retryWrites=true&w=majority

# Node environment (development or production)
NODE_ENV=development

# Email configuration (optional) - required for password reset emails
# Uses Google SMTP (gmail.com)
# 1. Enable 2-Step Verification on your Google account: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords (select Mail + Windows)
# 3. Set your Gmail and the 16-char app password below:
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
